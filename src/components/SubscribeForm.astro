---
// Kit (ConvertKit) inline signup, form 9207980. Same form and styling as the
// blog's post-subscribe block in BlogPostLayout, with the copy passed in.
interface Props {
  heading: string;
  desc: string;
  button?: string;
}
const { heading, desc, button = 'Subscribe' } = Astro.props;
---

<div class="sub">
  <div class="sub-inner">
    <div class="sub-text">
      <p class="sub-heading">{heading}</p>
      <p class="sub-desc">{desc}</p>
    </div>
    <script>
      const ckForm = document.querySelector('.formkit-form');
      if (ckForm) {
        const loadCk = () => {
          if (document.getElementById('ck-script')) return;
          const s = document.createElement('script');
          s.src = 'https://f.convertkit.com/ckjs/ck.5.js';
          s.id = 'ck-script';
          document.body.appendChild(s);
        };
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) { loadCk(); io.disconnect(); }
        }, { rootMargin: '400px' });
        io.observe(ckForm);
      }
    </script>
    <form
      action="https://app.kit.com/forms/9207980/subscriptions"
      class="seva-form formkit-form sub-form"
      method="post"
      data-sv-form="9207980"
      data-uid="53433df288"
      data-format="inline"
      data-version="5"
      data-options={JSON.stringify({"settings":{"after_subscribe":{"action":"message","success_message":"You're in! Check your email to confirm."},"powered_by":{"show":false},"recaptcha":{"enabled":false}},"version":"5"})}
    >
      <div data-style="clean">
        <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert"></ul>
        <div data-element="fields" data-stacked="false" class="seva-fields formkit-fields">
          <div class="formkit-field">
            <input class="formkit-input sub-input" name="email_address" aria-label="Email address" placeholder="Your email" required type="email" />
          </div>
          <button data-element="submit" class="formkit-submit btn sub-btn">
            <div class="formkit-spinner"><div></div><div></div><div></div></div>
            <span>{button}</span>
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<style>
  .sub-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-10);
    background-color: var(--color-forest);
    border-radius: var(--radius-lg);
  }
  .sub-text { flex: 1; min-width: 0; }
  .sub-heading {
    font-family: var(--ff-heading);
    font-size: var(--text-xl);
    color: var(--color-cream);
    margin-bottom: var(--space-1);
  }
  .sub-desc {
    font-size: var(--text-sm);
    color: var(--color-blush);
    opacity: 0.7;
    line-height: var(--leading-relaxed);
    max-width: none;
  }
  .sub-form { flex-shrink: 0; max-width: none !important; }
  .sub-form [data-style="clean"] { padding: 0 !important; }
  .sub-form .formkit-fields {
    display: flex !important;
    gap: var(--space-3) !important;
    flex-wrap: nowrap !important;
    margin: 0 !important;
  }
  .sub-form .formkit-field { flex: 0 0 auto !important; margin: 0 !important; }
  .sub-form .formkit-input.sub-input {
    height: var(--btn-height) !important;
    padding: 0 var(--space-5) !important;
    border-radius: var(--radius-full) !important;
    border: 1px solid var(--gray-300) !important;
    background-color: var(--color-cream) !important;
    font-family: var(--ff-body) !important;
    font-size: var(--text-base) !important;
    color: var(--color-ink) !important;
    width: 220px !important;
    line-height: var(--btn-height) !important;
  }
  .sub-form .formkit-input.sub-input::placeholder { color: var(--gray-400) !important; opacity: 1 !important; }
  .sub-form .formkit-input.sub-input:focus { outline: none !important; border-color: var(--color-gold) !important; }
  .sub-form .formkit-submit.sub-btn {
    --btn-bg-color: var(--color-ink);
    --btn-border-color: var(--color-ink);
    margin: 0 !important;
    flex: 0 0 auto !important;
  }
  .sub-form .formkit-submit.sub-btn > span { padding: 0 var(--btn-padding-x) !important; line-height: var(--btn-height) !important; }
  .sub-form .formkit-spinner { display: none; }
  .sub-form .formkit-submit[data-active] .formkit-spinner { display: flex; }
  .sub-form .formkit-alert { border-radius: var(--radius-full) !important; font-family: var(--ff-body) !important; font-size: var(--text-sm) !important; }
  .sub-form .formkit-powered-by-convertkit-container { display: none !important; }

  @media (max-width: 767px) {
    .sub-inner { flex-direction: column; align-items: stretch; padding: var(--space-6); }
    .sub-form .formkit-fields { flex-direction: column !important; }
    .sub-form .formkit-input.sub-input { width: 100% !important; }
  }
</style>
