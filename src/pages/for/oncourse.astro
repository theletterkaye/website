---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Stat from '../../components/Stat.astro';
import Card from '../../components/Card.astro';
---

<BaseLayout
  title="Kaye Putnam for Oncourse Home Solutions"
  description="A brief on why Kaye Putnam fits the Head of Brand Strategy role at Oncourse Home Solutions."
  noindex={true}
>
  <Nav />

  <main style="padding-top: var(--site-header-height);">

    <Section variant="default" size="lg">
      <p class="label" style="margin-bottom: var(--space-4);">Prepared for the Oncourse Home Solutions team</p>
      <h1 class="page-headline">Head of Brand Strategy, <em>with receipts</em>.</h1>
      <p style="max-width: 58ch; margin-top: var(--space-6); font-size: var(--text-lg);">
        I'm Kaye Putnam, a brand strategist and marketing leader in St. Charles, twenty minutes up the road from your Naperville office. Below, your role's requirements mapped to work I've already shipped.
      </p>
      <p style="max-width: 58ch; margin-top: var(--space-3); color: var(--gray-600);">
        (A personalized page for one specific account is exactly how I run partner and account-based marketing, so consider this a work sample too.)
      </p>
    </Section>

    <Section variant="dark" size="md">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--space-4);">
        <Stat variant="dark" value="$3.7M" label="ARR built from zero" />
        <Stat variant="dark" value="$190M+" label="Client revenue managed" />
        <Stat variant="dark" value="75+" label="Recurring-revenue clients" />
        <Stat variant="dark" value="250K+" label="Brand quiz takers" />
      </div>
    </Section>

    <Section variant="warm" size="lg">
      <h2 class="label" style="margin-bottom: var(--space-8);">Your requirements, mapped to shipped work</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: var(--space-6);">
        <Card
          eyebrow="You asked for brand strategy across stakeholders"
          title="A four-brand portfolio, built and stewarded"
          excerpt="I lead brand strategy for a consumer hospitality brand, a B2B consultancy, and two founder brands: voice systems, guidelines, and messaging activated across the full customer journey, from acquisition through renewal."
          href="/work/freewyld-foundry"
          image="/for/oncourse/foundry-home.png"
          imageAlt="Freewyld Foundry website homepage"
        />
        <Card
          eyebrow="You asked for practical, results-first brand thinking"
          title="A framework 250,000+ people have used"
          excerpt="My psychology-driven archetype framework has defined positioning and value propositions for 100+ companies. It exists because brand strategy should move revenue, and it's been doing that for a decade."
          href="/brand-archetypes"
          image="/for/oncourse/kp-archetypes.png"
          imageAlt="Brand archetypes framework page"
        />
        <Card
          eyebrow="You asked how the brand shows up in AI search"
          title="AI-era discoverability, already in production"
          excerpt="Structured data across 25+ page types, a deliberate AI-crawler policy, and a documented playbook so the brand surfaces when buyers research through ChatGPT, Claude, and Perplexity. Built, shipped, measurable."
          href="/work/brand-archetype-quiz"
          image="/for/oncourse/kp-quiz.png"
          imageAlt="Natively rebuilt brand personality quiz"
        />
        <Card
          eyebrow="You asked for creative direction and journey activation"
          title="A consumer brand experience, end to end"
          excerpt="I rebuilt the Freewyld guest experience from brand identity through booking flow to lifecycle email, directing creative across web, video, social, and email with one consistent voice."
          href="/work/freewyld-cabins"
          image="/for/oncourse/freewyld-home.png"
          imageAlt="Freewyld hospitality brand website"
        />
      </div>
    </Section>

    <Section variant="default" size="md">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-8);">
        <div>
          <h3 class="label" style="margin-bottom: var(--space-3);">Storytelling &amp; earned media</h3>
          <p>20+ published client case studies with a per-client approval workflow. Founder placements on industry podcasts, VRMA speaking in 2025 and 2026, and consumer press including Staycation TV and Visit California.</p>
        </div>
        <div>
          <h3 class="label" style="margin-bottom: var(--space-3);">Partner marketing (B2B2C)</h3>
          <p>Co-created an 80-90 attendee industry event with partner Proper Insurance, then grew it into an ongoing content partnership: a joint podcast episode, coordinated blog content, and a dedicated partner page.</p>
        </div>
        <div>
          <h3 class="label" style="margin-bottom: var(--space-3);">Teams &amp; creative leadership</h3>
          <p>Twelve years leading creative teams, from a core of three to project teams of fifteen. Today I lead marketing inside a 20-person company as part of its leadership team.</p>
        </div>
      </div>
    </Section>

    <Section variant="cream" size="lg">
      <h2 class="label" style="margin-bottom: var(--space-4);">Let's talk</h2>
      <p style="max-width: 58ch; margin-bottom: var(--space-6);">
        The tailored resume below covers the full twenty years. I'd welcome a conversation about what brand strategy can do for Oncourse and American Water Resources.
      </p>
      <p>
        <a href="/for/oncourse/Kaye-Putnam-Resume-Oncourse.pdf">Download my resume (PDF)</a><br />
        <a href="mailto:kayeputnam@gmail.com">kayeputnam@gmail.com</a><br />
        <a href="https://www.linkedin.com/in/kayeputnam/">LinkedIn</a>
      </p>
    </Section>

  </main>

  <Footer />
</BaseLayout>
