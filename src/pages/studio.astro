---
import StudioDash from '../components/StudioDash.jsx';

// Kaye's private social dashboard. Hidden: noindex, out of the sitemap, linked
// from nowhere, and nothing loads without the passcode. Standalone page (no
// site chrome) since it's a phone app for her. Data comes from /api/studio.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#132217" />
    <meta name="apple-mobile-web-app-title" content="Studio" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>Studio</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://use.typekit.net/gvu8enl.css" />
  </head>
  <body style="margin:0;background:#F7F7F5">
    <StudioDash client:only="react" />
  </body>
</html>
