---
import SwimTracker from '../components/SwimTracker.jsx';

// Family swim tracker. Hidden: noindex, out of the sitemap, and linked from
// nowhere. Standalone page (no site chrome) since it's a phone app for us, not
// part of the public site. Data comes from /api/swim.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A1F33" />
    <meta name="apple-mobile-web-app-title" content="Lane Lines" />
    <title>Lane Lines</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <SwimTracker client:only="react" />
  </body>
</html>
